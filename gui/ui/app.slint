import { Theme, Icons } from "theme.slint";
import { Sidebar } from "components/nav.slint";
import { OverviewPage } from "pages/overview.slint";
import { NodesPage } from "pages/nodes.slint";
import { AdvancedSheet } from "pages/node_editor.slint";
import { SettingsPage, SettingSheet } from "pages/settings.slint";
import { Page, AppState, NodeStore, SettingsStore, Actions, Fmt, TrayText } from "state.slint";
export { Theme, Icons } from "theme.slint";
export { Page, Connection, ProxyMode, PacRule, PacSource, Protocol, StartupConnection, Notice, NodeField, SettingField, NodeCommand, NodeRow, NodeDraft, FieldError, MenuItem, Versions, AppState, NodeStore, SettingsStore, Actions, Fmt, TrayText, FieldText } from "state.slint";
import { Field, LabeledField } from "components/field.slint";
import { PopupMenu } from "components/menu.slint";
import { Sheet, Banner } from "components/sheet.slint";
import { ScrollArea } from "components/scroll.slint";

export component MainWindow inherits Window {
    title: "juicity";
    // Window and taskbar icon on Windows and X11; Wayland uses the app id.
    icon: Icons.logo;
    min-width: 960px;
    min-height: 640px;
    preferred-width: 960px;
    preferred-height: 640px;
    background: Theme.window;
    default-font-family: Theme.cjk;
    default-font-size: 14px;
    HorizontalLayout {
        Sidebar { }
        VerticalLayout {
            padding-left: 24px;
            padding-right: 24px;
            padding-bottom: 24px;
            alignment: start;
            if AppState.page == Page.overview: OverviewPage { }
            if AppState.page == Page.nodes: NodesPage { }
        }
    }
    // Recreated on every open, so its fields start from the sheet draft.
    // Outside the layout so its scroll area can fill the window height
    // without a layout binding loop; geometry matches the page column.
    if AppState.page == Page.settings: SettingsPage {
        x: 224px;
        y: 0px;
        width: root.width - 248px;
        // The scroll content carries the 24 px bottom padding.
        height: root.height;
    }
    if NodeStore.advanced-open: AdvancedSheet { }
    if SettingsStore.sheet-open: SettingSheet { }
}
