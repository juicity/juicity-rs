import { Theme, Icons } from "../theme.slint";
import { Caption, Icon } from "primitives.slint";
import { Fmt } from "../state.slint";

export component Field inherits VerticalLayout {
    in-out property <string> text;
    // Accessible name of the input.
    in property <string> label;
    in property <string> placeholder;
    in property <string> error;
    in property <bool> latin: true;
    in property <bool> password: false;
    in property <bool> read-only: false;
    in property <image> icon;
    in property <bool> has-icon: false;
    private property <bool> reveal;
    // At rest a hidden password shows small bullets; editing uses the input's own mask.
    private property <bool> masked: root.password && !root.reveal && !input.has-focus;
    out property <bool> has-focus <=> input.has-focus;
    callback edited(string);
    callback accepted;
    callback icon-clicked;
    forward-focus: input;
    spacing: 4px;
    Rectangle {
        height: 36px;
        border-radius: 8px;
        background: Theme.pill;
        HorizontalLayout {
            padding-left: 12px;
            padding-right: 10px;
            spacing: 8px;
            Rectangle {
                horizontal-stretch: 1;
                Text {
                    text: root.placeholder;
                    visible: root.text == "";
                    font-family: root.latin ? Theme.latin : Theme.cjk;
                    font-size: 14px;
                    color: Theme.secondary;
                    vertical-alignment: center;
                }
                if root.masked: Text {
                    x: 0px;
                    width: parent.width;
                    horizontal-alignment: left;
                    text: Fmt.mask(root.text);
                    font-family: root.latin ? Theme.latin : Theme.cjk;
                    font-size: 14px;
                    color: Theme.text;
                    vertical-alignment: center;
                }
                input := TextInput {
                    opacity: root.masked ? 0 : 1;
                    text <=> root.text;
                    font-family: root.latin ? Theme.latin : Theme.cjk;
                    font-size: 14px;
                    color: Theme.text;
                    vertical-alignment: center;
                    single-line: true;
                    read-only: root.read-only;
                    input-type: root.password && !root.reveal ? InputType.password : InputType.text;
                    accessible-role: text-input;
                    accessible-label: root.label;
                    accessible-value: root.password ? "" : self.text;
                    accessible-read-only: root.read-only;
                    accessible-action-set-value(value) => {
                        if !root.read-only {
                            self.text = value;
                            root.edited(value);
                        }
                    }
                    edited => { root.edited(self.text); }
                    accepted => { root.accepted(); }
                }
            }
            if root.password || root.has-icon: Rectangle {
                width: 18px;
                Icon { source: root.password ? Icons.eye : root.icon; colorize: Theme.secondary; }
                TouchArea {
                    clicked => {
                        if root.password { root.reveal = !root.reveal; }
                        else { root.icon-clicked(); }
                    }
                }
            }
        }
    }
    if root.error != "": Caption { text: root.error; color: Theme.red; }
}

export component LabeledField inherits VerticalLayout {
    in property <string> label;
    in-out property <string> text;
    in property <string> placeholder;
    in property <string> error;
    in property <bool> latin: true;
    in property <bool> password: false;
    in property <bool> read-only: false;
    in property <image> icon;
    in property <bool> has-icon: false;
    out property <bool> has-focus <=> field.has-focus;
    callback edited(string);
    callback accepted;
    callback icon-clicked;
    forward-focus: field;
    spacing: 6px;
    Caption { text: root.label; }
    field := Field {
        text <=> root.text;
        label: root.label;
        placeholder: root.placeholder;
        error: root.error;
        latin: root.latin;
        password: root.password;
        read-only: root.read-only;
        icon: root.icon;
        has-icon: root.has-icon;
        edited(value) => { root.edited(value); }
        accepted => { root.accepted(); }
        icon-clicked => { root.icon-clicked(); }
    }
}
