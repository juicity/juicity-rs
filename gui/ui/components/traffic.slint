import { Theme } from "../theme.slint";
import { TrafficStore } from "../state.slint";
import { Caption } from "primitives.slint";

component Stat inherits VerticalLayout {
    in property <string> label;
    in property <string> value;
    in property <color> marker;
    spacing: 2px;
    horizontal-stretch: 1;
    min-width: 0px;
    preferred-width: 0px;
    HorizontalLayout {
        spacing: 6px;
        alignment: start;
        VerticalLayout { alignment: center; Rectangle { width: 8px; height: 8px; border-radius: 4px; background: root.marker; } }
        Caption { text: root.label; overflow: elide; }
    }
    Text { text: root.value; font-family: Theme.latin; font-size: 17px; font-weight: 500; color: Theme.text; height: 22px; vertical-alignment: center; overflow: elide; }
}

// Download and upload speed curves rising from a shared baseline; the path
// commands come from Rust in viewbox units, so they fit any chart size.
component ChartCurve inherits Path {
    width: 100%;
    height: 100%;
    viewbox-x: 0;
    viewbox-y: 0;
    viewbox-width: max(1, TrafficStore.slots - 1);
    viewbox-height: 1;
    fit: fill;
    // The fit insets by half the stroke width (in pixels, not viewbox units),
    // so every curve uses the same width for the area to meet its line.
    stroke-width: 1.5px;
    stroke-line-join: round;
    stroke-line-cap: round;
}

component TrafficChart inherits Rectangle {
    // Fills the row below the title, so the card ends where the others do.
    height: 68px;
    private property <length> mid: self.height / 2;
    for offset in [0, 0.5, 1, 1.5]: Rectangle { y: root.mid * offset; height: 1px; background: Theme.divider; }
    Rectangle { y: root.height - 1px; height: 1px; background: Theme.divider; }
    // A small top inset keeps the peak's stroke clear of the top grid line.
    Rectangle {
        y: 3px;
        height: parent.height - 3px;
        ChartCurve { commands: TrafficStore.down-area; fill: Theme.text.with-alpha(0.1); stroke: transparent; }
        ChartCurve { commands: TrafficStore.up-line; stroke: Theme.secondary; }
        ChartCurve { commands: TrafficStore.down-line; stroke: Theme.text; }
    }
    if !TrafficStore.has-traffic: Text {
        text: @tr("No traffic yet");
        font-size: 12px;
        color: Theme.secondary;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// The card title, then the four speeds and totals in one row beside the
// speed history chart; one stat row keeps the whole Overview within the
// default window.
export component TrafficPanel inherits VerticalLayout {
    Caption { text: @tr("Traffic"); }
    Rectangle { height: 4px; }
    HorizontalLayout {
        spacing: 24px;
        VerticalLayout {
            alignment: start;
            horizontal-stretch: 0;
            width: 448px;
            HorizontalLayout {
                spacing: 16px;
                Stat { label: @tr("Download"); value: TrafficStore.down-speed; marker: Theme.text; }
                Stat { label: @tr("Upload"); value: TrafficStore.up-speed; marker: Theme.secondary; }
                Stat { label: @tr("Downloaded"); value: TrafficStore.down-total; marker: Theme.text; }
                Stat { label: @tr("Uploaded"); value: TrafficStore.up-total; marker: Theme.secondary; }
            }
        }
        TrafficChart {
            horizontal-stretch: 1;
            min-width: 0px;
        }
    }
}
