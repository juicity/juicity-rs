import { Theme, Icons } from "../theme.slint";
import { TrafficStore } from "../state.slint";
import { Caption, Icon } from "primitives.slint";

// A speed or total behind its direction arrow; the label names it for
// assistive technology only.
component Reading inherits HorizontalLayout {
    in property <image> icon;
    in property <color> tint;
    in property <string> label;
    in property <string> value;
    in property <length> icon-size;
    in property <length> font-size;
    in property <int> font-weight;
    in property <color> color;
    spacing: 4px;
    VerticalLayout { alignment: center; Icon { source: root.icon; size: root.icon-size; colorize: root.tint; } }
    Text {
        text: root.value;
        accessible-label: root.label;
        accessible-value: root.value;
        font-family: Theme.latin;
        font-size: root.font-size;
        font-weight: root.font-weight;
        color: root.color;
        vertical-alignment: center;
    }
}

// Download and upload speed curves rising from a shared baseline; the path
// commands come from Rust in viewbox units, so they fit any chart size.
component ChartCurve inherits Path {
    width: 100%;
    height: 100%;
    viewbox-x: 0;
    viewbox-y: 0;
    viewbox-width: max(1, TrafficStore.slots - 1);
    viewbox-height: 1;
    fit: fill;
    // The fit insets by half the stroke width (in pixels, not viewbox units),
    // so every curve uses the same width for the area to meet its line.
    stroke-width: 1.5px;
    stroke-line-join: round;
    stroke-line-cap: round;
}

component TrafficChart inherits Rectangle {
    // Takes the card's height below the header, down to the page bottom.
    min-height: 64px;
    vertical-stretch: 1;
    private property <length> mid: self.height / 2;
    for offset in [0, 0.5, 1, 1.5]: Rectangle { y: root.mid * offset; height: 1px; background: Theme.divider; }
    Rectangle { y: root.height - 1px; height: 1px; background: Theme.divider; }
    // A small top inset keeps the peak's stroke clear of the top grid line.
    Rectangle {
        y: 3px;
        height: parent.height - 3px;
        ChartCurve { commands: TrafficStore.down-area; fill: Theme.text.with-alpha(0.1); stroke: transparent; }
        ChartCurve { commands: TrafficStore.up-line; stroke: Theme.secondary; }
        ChartCurve { commands: TrafficStore.down-line; stroke: Theme.text; }
    }
    if !TrafficStore.has-traffic: Text {
        text: @tr("No traffic yet");
        font-size: 12px;
        color: Theme.secondary;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// The card title with the speeds and session totals on the right, then the
// speed history chart across the full card width; the chart grows to fill
// the rest of the Overview.
export component TrafficPanel inherits VerticalLayout {
    HorizontalLayout {
        height: 20px;
        spacing: 16px;
        VerticalLayout { alignment: center; horizontal-stretch: 1; min-width: 0px; Caption { text: @tr("Traffic"); overflow: elide; } }
        Reading { icon: Icons.arrow-down; tint: Theme.text; label: @tr("Download"); value: TrafficStore.down-speed; icon-size: 16px; font-size: 15px; font-weight: 500; color: Theme.text; }
        Reading { icon: Icons.arrow-up; tint: Theme.secondary; label: @tr("Upload"); value: TrafficStore.up-speed; icon-size: 16px; font-size: 15px; font-weight: 500; color: Theme.text; }
        HorizontalLayout {
            spacing: 8px;
            Reading { icon: Icons.arrow-down; tint: Theme.text; label: @tr("Downloaded"); value: TrafficStore.down-total; icon-size: 12px; font-size: 12px; font-weight: 400; color: Theme.secondary; }
            Reading { icon: Icons.arrow-up; tint: Theme.secondary; label: @tr("Uploaded"); value: TrafficStore.up-total; icon-size: 12px; font-size: 12px; font-weight: 400; color: Theme.secondary; }
        }
    }
    Rectangle { height: 4px; }
    TrafficChart { }
}
