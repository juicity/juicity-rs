export enum Page { overview, nodes, logs, settings }
export enum Connection { stopped, starting, running }
export enum ProxyMode { off, pac, global }
export enum PacRule { bypass-china, gfw-list }
export enum PacSource { local, online }
export enum Protocol { juicity, shadowsocks }
export enum StartupConnection { off, on, last }
export enum Notice { none, imported, link-copied, start-failed, rules-updated, rules-failed, proxy-failed, save-failed, core-exited, no-node, missing-fields, import-failed, export-failed, import-partial, export-invalid }
export enum NodeField { name, protocol, server, port, uuid, password, method, sni, allow-insecure, pinned-certchain-sha256, congestion-control, plugin, plugin-options, plugin-args, timeout, group }
export enum SettingField { mixed-port, direct-url, proxy-url, update-hours, pac-listen, online-pac-url }
export enum NodeCommand { move-up, move-down, duplicate, delete }

export struct NodeRow {
    id: string,
    name: string,
    address: string,
    protocol: Protocol,
    in-use: bool,
    group: string,
}
export struct NodeDraft {
    name: string,
    protocol: Protocol,
    server: string,
    port: string,
    uuid: string,
    password: string,
    method: string,
    sni: string,
    allow-insecure: bool,
    pinned-certchain-sha256: string,
    congestion-control: string,
    plugin: string,
    plugin-options: string,
    plugin-args: string,
    timeout: string,
    group: string,
}
export struct FieldError { field: NodeField, message: string }
export struct MenuItem { text: string, checked: bool, enabled: bool }
// One captured log line; the text stays English.
export struct LogRow { time: string, level: string, target: string, message: string }
// One chart slot (0 = oldest of HISTORY); heights are fractions of half the chart.
export struct TrafficBar { slot: int, down: float, up: float }
export struct Versions { gui: string, juicity: string, shadowsocks: string, tag: string, commit: string }

export global AppState {
    in-out property <Page> page: Page.overview;
    // Set by the tray's About item; the settings page scrolls to About and clears it.
    in-out property <bool> reveal-about;
    in-out property <Connection> connection: Connection.stopped;
    in-out property <string> active-name;
    in-out property <string> active-address;
    in-out property <string> local-port;
    in-out property <string> local-host;
    in-out property <string> pac-url;
    in-out property <ProxyMode> proxy-mode: ProxyMode.off;
    in-out property <PacRule> pac-rule: PacRule.bypass-china;
    // Days since the rules were downloaded (-1: never) and the time or date to show.
    in-out property <int> rules-age-days: -1;
    in-out property <string> rules-time;
    in-out property <bool> rules-updating;
    in-out property <Notice> notice: Notice.none;
    in-out property <string> notice-detail;
    // Second value of a notice (skipped links).
    in-out property <string> notice-extra;
    in-out property <bool> notice-error;
    out property <string> connection-text: connection == Connection.running ? @tr("Connected · {}", active-name) : connection == Connection.starting ? @tr("Connecting…") : @tr("Disconnected");
    out property <string> proxy-text: proxy-mode == ProxyMode.pac ? @tr("System proxy · PAC") : proxy-mode == ProxyMode.global ? @tr("System proxy · Global") : @tr("System proxy · Off");
    out property <string> notice-text: notice == Notice.imported ? @tr("Links imported") : notice == Notice.link-copied ? @tr("Link copied") : notice == Notice.start-failed ? @tr("Could not start proxy: {}", notice-detail) : notice == Notice.rules-updated ? @tr("Rules updated") : notice == Notice.rules-failed ? @tr("Could not update rules: {}", notice-detail) : notice == Notice.proxy-failed ? @tr("Could not set system proxy: {}", notice-detail) : notice == Notice.save-failed ? @tr("Could not save settings: {}", notice-detail) : notice == Notice.core-exited ? @tr("Proxy stopped: {}", notice-detail) : notice == Notice.no-node ? @tr("Add a node first") : notice == Notice.missing-fields ? @tr("Missing fields: {}", notice-detail) : notice == Notice.import-failed ? @tr("Could not import link: {}", notice-detail) : notice == Notice.export-failed ? @tr("Could not export link: {}", notice-detail) : notice == Notice.import-partial ? @tr("Links imported: {}, skipped: {}", notice-detail, notice-extra) : notice == Notice.export-invalid ? @tr("Fix the invalid fields before exporting") : "";
    out property <string> rules-updated-at: rules-age-days == 0 ? @tr("Today {}", rules-time) : rules-age-days == 1 ? @tr("Yesterday {}", rules-time) : rules-time;
}
export global NodeStore {
    in-out property <[NodeRow]> rows;
    in-out property <int> selected: -1;
    in-out property <NodeDraft> draft;
    in-out property <[FieldError]> errors;
    in-out property <bool> reconnect-required;
    in-out property <bool> advanced-open;
    in-out property <NodeDraft> advanced-draft;
    in-out property <[string]> methods;
    // Shadowsocks methods with the draft's method checked.
    in-out property <[MenuItem]> method-items;
    // Bumped whenever Rust replaces the draft; editor text fields reload only then.
    in-out property <int> draft-serial;
    // Bumped when the 進階設定 sheet opens; its text fields reload only then.
    in-out property <int> advanced-serial;
    in-out property <string> server-error;
    in-out property <string> uuid-error;
    in-out property <string> password-error;
    in-out property <string> port-error;
    in-out property <string> timeout-error;
}
export global SettingsStore {
    // Menu order: system, English, Simplified Chinese, Traditional Chinese, Russian.
    in-out property <int> language;
    in-out property <bool> autostart;
    // False where starting at login is not implemented yet.
    in-out property <bool> autostart-supported: true;
    in-out property <bool> hide-on-start;
    in-out property <bool> close-to-tray;
    in-out property <StartupConnection> startup-connection: StartupConnection.off;
    in-out property <string> mixed-port;
    in-out property <string> direct-url;
    in-out property <string> proxy-url;
    in-out property <int> update-hours;
    // update-hours is not a menu preset; shown as an extra checked item.
    in-out property <bool> update-custom;
    in-out property <PacSource> pac-source: PacSource.local;
    in-out property <string> pac-listen;
    in-out property <string> online-pac-url;
    in-out property <Versions> versions;
    // Bumped when a sheet opens; its text field loads sheet-draft only then.
    in-out property <int> sheet-serial;
    in-out property <bool> sheet-open;
    in-out property <SettingField> sheet-field;
    in-out property <string> sheet-draft;
    in-out property <string> sheet-error;
}
export global LogStore {
    in-out property <[LogRow]> rows;
    in-out property <int> dropped;
    // On: the list sticks to the newest line.
    in-out property <bool> follow: true;
    // Most characters in a row's target plus message, for the scroll width.
    in-out property <int> max-chars;
    // Bumped when rows are replaced, so a following list scrolls to the tail.
    in-out property <int> serial;
    in-out property <[TrafficBar]> bars;
    // Number of chart slots (traffic::HISTORY).
    in-out property <int> slots: 60;
    in-out property <bool> has-traffic;
    in-out property <string> down-speed;
    in-out property <string> up-speed;
    in-out property <string> down-total;
    in-out property <string> up-total;
}
export global Actions {
    callback navigate(Page);
    callback toggle-connection;
    callback set-proxy-mode(ProxyMode);
    callback set-pac-rule(PacRule);
    callback update-rules;
    callback copy-pac-url;
    callback dismiss-notice;
    callback select-node(int);
    callback add-node;
    callback import-links;
    callback node-command(int, NodeCommand);
    callback edit-node(NodeField, string);
    callback set-active-node;
    callback export-link;
    callback open-advanced;
    callback edit-advanced(NodeField, string);
    callback commit-advanced;
    callback cancel-advanced;
    callback set-autostart(bool);
    callback set-language(int);
    callback set-hide-on-start(bool);
    callback set-close-to-tray(bool);
    callback set-startup-connection(StartupConnection);
    callback set-pac-source(PacSource);
    callback set-update-hours(int);
    callback open-setting(SettingField);
    callback edit-setting(string);
    callback commit-setting;
    callback cancel-setting;
    callback set-log-follow(bool);
    callback clear-logs;
    callback quit;
}
export global Fmt {
    pure callback elide-middle(string, length, length) -> string;
    // One bullet per character, drawn like the mockup's masked value.
    pure callback mask(string) -> string;
}
// Names of mandatory node fields, joined by Rust for the missing-fields notice.
export global FieldText {
    out property <string> server: @tr("Server");
    out property <string> uuid: "UUID";
    out property <string> password: @tr("Password");
    out property <string> separator: @tr(", ");
    out property <string> required-error: @tr("Required");
    out property <string> port-error: @tr("Enter a port from 1 to 65535");
    out property <string> timeout-error: @tr("Enter a whole number of seconds");
    out property <string> listen-error: @tr("Enter an address as host:port");
    out property <string> url-error: @tr("Enter a URL that starts with http:// or https://");
    out property <string> hours-error: @tr("Enter a whole number of hours, 1 or more");
    public pure function new-node-name(index: int) -> string { return @tr("Node {}", index); }
}
export global TrayText {
    out property <string> status: AppState.connection-text;
    out property <string> proxy-status: AppState.proxy-text;
    out property <string> connect: AppState.connection == Connection.running ? @tr("Disconnect") : @tr("Connect");
    out property <string> system-proxy: @tr("System proxy");
    out property <string> off: @tr("Off");
    out property <string> pac: "PAC";
    out property <string> global: @tr("Global");
    out property <string> bypass-china: @tr("Bypass mainland China");
    out property <string> gfw-list: @tr("Proxy GFW list only");
    out property <string> update-rules: @tr("Update rules");
    out property <string> nodes: @tr("Nodes");
    out property <string> import-clipboard: @tr("Import from clipboard");
    out property <string> open: @tr("Open juicity");
    out property <string> edit-nodes: @tr("Nodes…");
    out property <string> logs: @tr("View Logs…");
    out property <string> settings: @tr("Settings…");
    out property <string> about: @tr("About juicity");
    out property <string> quit: @tr("Quit");
}
