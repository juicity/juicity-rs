import { Theme } from "../theme.slint";
import { AppState, LogStore, Notice, Actions } from "../state.slint";
import { Caption, Card, Button, Switch } from "../components/primitives.slint";
import { PageHeader } from "../components/nav.slint";
import { Banner } from "../components/sheet.slint";
import { ListView } from "../components/scroll.slint";

// Metrics of the monospaced log rows.
global LogMetrics {
    out property <length> row: 20px;
    out property <length> font-size: 12px;
    out property <length> advance: self.font-size * Theme.mono-advance;
}

export component LogsPage inherits VerticalLayout {
    private property <int> serial: LogStore.serial;
    private property <bool> follow: LogStore.follow;
    private property <length> list-height: list.visible-height;
    private property <length> list-y: list.content-y;
    private property <length> last-y;
    function to-tail() {
        list.content-y = min(0px, list.visible-height - list.content-height);
    }
    function stop-follow() {
        if LogStore.follow { Actions.set-log-follow(false); }
    }
    init => { if LogStore.follow { root.to-tail(); } }
    changed serial => { if LogStore.follow { root.to-tail(); } }
    changed follow => { if root.follow { root.to-tail(); } }
    changed list-height => { if LogStore.follow { root.to-tail(); } }
    // A move up that ends short of the tail is the user's (a content drag,
    // or wheel ticks the Flickable keeps from the list's own handler);
    // `to-tail` always ends at the tail.
    changed list-y => {
        if root.list-y > root.last-y + 0.5px && root.list-y > list.visible-height - list.content-height + 0.5px {
            root.stop-follow();
        }
        root.last-y = root.list-y;
    }
    spacing: 16px;
    // The page sits outside the window layout, so it carries the bottom padding.
    padding-bottom: 24px;
    PageHeader {
        title: @tr("Logs");
        // Shrinks and elides first, so Follow and Clear stay visible.
        if LogStore.dropped > 0: VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            min-width: 0px;
            padding-right: 8px;
            Caption {
                text: @tr("{n} earlier line dropped" | "{n} earlier lines dropped" % LogStore.dropped);
                horizontal-alignment: right;
                overflow: elide;
                min-width: 0px;
            }
        }
        HorizontalLayout {
            spacing: 8px;
            horizontal-stretch: 0;
            padding-right: 8px;
            Text { text: @tr("Follow"); font-size: 14px; color: Theme.text; vertical-alignment: center; }
            VerticalLayout { alignment: center; Switch { on <=> LogStore.follow; toggled(on) => { Actions.set-log-follow(on); } } }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            Button { text: @tr("Clear"); clicked => { Actions.clear-logs(); } }
        }
    }
    if AppState.notice != Notice.none: Banner {
        text: AppState.notice-text;
        error: AppState.notice-error;
        dismissed => { Actions.dismiss-notice(); }
    }
    Card {
        vertical-stretch: 1;
        min-height: 120px;
        list := ListView {
            x: 4px;
            y: 8px;
            width: parent.width - 8px;
            height: parent.height - 16px;
            // Columns: time (8), level (5), then target and message.
            content-width: max(self.visible-width, 24px + 36px + (13 + LogStore.max-chars) * LogMetrics.advance);
            content-height: max(self.visible-height, LogStore.rows.length * LogMetrics.row);
            scrolled-up => { root.stop-follow(); }
            for row in LogStore.rows: Rectangle {
                width: list.content-width;
                height: LogMetrics.row;
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 12px;
                    alignment: start;
                    Text { text: row.time; font-family: Theme.mono; font-size: LogMetrics.font-size; color: Theme.secondary; vertical-alignment: center; }
                    Text {
                        text: row.level;
                        width: 5 * LogMetrics.advance;
                        font-family: Theme.mono;
                        font-size: LogMetrics.font-size;
                        color: row.level == "ERROR" ? Theme.red : row.level == "WARN" ? Theme.orange : Theme.secondary;
                        vertical-alignment: center;
                    }
                    Text { text: row.target; font-family: Theme.mono; font-size: LogMetrics.font-size; color: Theme.secondary; vertical-alignment: center; }
                    Text { text: row.message; font-family: Theme.mono; font-size: LogMetrics.font-size; color: Theme.text; vertical-alignment: center; }
                }
            }
        }
    }
}
