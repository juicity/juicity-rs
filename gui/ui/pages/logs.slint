import { Theme } from "../theme.slint";
import { AppState, LogStore, Notice, Actions } from "../state.slint";
import { Caption, Card, Button, Switch } from "../components/primitives.slint";
import { PageHeader } from "../components/nav.slint";
import { Banner } from "../components/sheet.slint";
import { ListView } from "../components/scroll.slint";

// Metrics of the monospaced log rows.
global LogMetrics {
    out property <length> row: 20px;
    out property <length> font-size: 12px;
    out property <length> advance: self.font-size * Theme.mono-advance;
}

component Stat inherits VerticalLayout {
    in property <string> label;
    in property <string> value;
    in property <color> marker;
    spacing: 4px;
    horizontal-stretch: 1;
    min-width: 0px;
    preferred-width: 0px;
    HorizontalLayout {
        spacing: 6px;
        alignment: start;
        VerticalLayout { alignment: center; Rectangle { width: 8px; height: 8px; border-radius: 4px; background: root.marker; } }
        Caption { text: root.label; overflow: elide; }
    }
    Text { text: root.value; font-family: Theme.latin; font-size: 17px; font-weight: 500; color: Theme.text; height: 22px; vertical-alignment: center; overflow: elide; }
}

// Download bars above the centre line, upload bars below it (as upstream).
component TrafficChart inherits Rectangle {
    height: 130px;
    private property <length> mid: self.height / 2;
    private property <length> slot: self.width / max(1, LogStore.slots);
    for offset in [0, 0.5, 1, 1.5]: Rectangle { y: root.mid * offset; height: 1px; background: Theme.divider; }
    Rectangle { y: root.height - 1px; height: 1px; background: Theme.divider; }
    for bar in LogStore.bars: Rectangle {
        x: root.slot * bar.slot;
        width: max(1px, root.slot * 0.72);
        height: root.mid * bar.down;
        y: root.mid - self.height;
        visible: self.height > 0.5px;
        background: Theme.text;
    }
    for bar in LogStore.bars: Rectangle {
        x: root.slot * bar.slot;
        width: max(1px, root.slot * 0.72);
        y: root.mid;
        height: root.mid * bar.up;
        visible: self.height > 0.5px;
        background: Theme.secondary;
    }
    if !LogStore.has-traffic: Text {
        text: @tr("No traffic yet");
        font-size: 12px;
        color: Theme.secondary;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component LogsPage inherits VerticalLayout {
    private property <int> serial: LogStore.serial;
    private property <bool> follow: LogStore.follow;
    private property <length> list-height: list.visible-height;
    function to-tail() {
        list.content-y = min(0px, list.visible-height - list.content-height);
    }
    init => { if LogStore.follow { root.to-tail(); } }
    changed serial => { if LogStore.follow { root.to-tail(); } }
    changed follow => { if root.follow { root.to-tail(); } }
    changed list-height => { if LogStore.follow { root.to-tail(); } }
    spacing: 16px;
    // The page sits outside the window layout, so it carries the bottom padding.
    padding-bottom: 24px;
    PageHeader {
        title: @tr("Logs");
        if LogStore.dropped > 0: VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            padding-right: 8px;
            Caption { text: @tr("{n} earlier line dropped" | "{n} earlier lines dropped" % LogStore.dropped); }
        }
        HorizontalLayout {
            spacing: 8px;
            horizontal-stretch: 0;
            padding-right: 8px;
            Text { text: @tr("Follow"); font-size: 14px; color: Theme.text; vertical-alignment: center; }
            VerticalLayout { alignment: center; Switch { on <=> LogStore.follow; toggled(on) => { Actions.set-log-follow(on); } } }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            Button { text: @tr("Clear"); clicked => { Actions.clear-logs(); } }
        }
    }
    if AppState.notice != Notice.none: Banner {
        text: AppState.notice-text;
        error: AppState.notice-error;
        dismissed => { Actions.dismiss-notice(); }
    }
    Card {
        VerticalLayout {
            padding: 20px;
            spacing: 16px;
            HorizontalLayout {
                spacing: 16px;
                Stat { label: @tr("Download"); value: LogStore.down-speed; marker: Theme.text; }
                Stat { label: @tr("Upload"); value: LogStore.up-speed; marker: Theme.secondary; }
                Stat { label: @tr("Downloaded"); value: LogStore.down-total; marker: Theme.text; }
                Stat { label: @tr("Uploaded"); value: LogStore.up-total; marker: Theme.secondary; }
            }
            TrafficChart { }
        }
    }
    Card {
        vertical-stretch: 1;
        min-height: 120px;
        list := ListView {
            x: 4px;
            y: 8px;
            width: parent.width - 8px;
            height: parent.height - 16px;
            // Columns: time (8), level (5), then target and message.
            content-width: max(self.visible-width, 24px + 36px + (13 + LogStore.max-chars) * LogMetrics.advance);
            content-height: max(self.visible-height, LogStore.rows.length * LogMetrics.row);
            scrolled => {
                if LogStore.follow && self.content-y > self.visible-height - self.content-height + 1px {
                    Actions.set-log-follow(false);
                }
            }
            for row in LogStore.rows: Rectangle {
                width: list.content-width;
                height: LogMetrics.row;
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 12px;
                    alignment: start;
                    Text { text: row.time; font-family: Theme.mono; font-size: LogMetrics.font-size; color: Theme.secondary; vertical-alignment: center; }
                    Text {
                        text: row.level;
                        width: 5 * LogMetrics.advance;
                        font-family: Theme.mono;
                        font-size: LogMetrics.font-size;
                        color: row.level == "ERROR" ? Theme.red : row.level == "WARN" ? Theme.orange : Theme.secondary;
                        vertical-alignment: center;
                    }
                    Text { text: row.target; font-family: Theme.mono; font-size: LogMetrics.font-size; color: Theme.secondary; vertical-alignment: center; }
                    Text { text: row.message; font-family: Theme.mono; font-size: LogMetrics.font-size; color: Theme.text; vertical-alignment: center; }
                }
            }
        }
    }
}
